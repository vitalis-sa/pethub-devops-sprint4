    {
      "name": "5. Atendimento com IA (Groq)",
      "item": [
        {
          "name": "5.1 Gerar rascunho da análise (não grava nada)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
