                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVet}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status esperado (200, 201)', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('unidadeId', corpo.id);"
                ]
              }
            }
          ]
        }
      ]
    },
