    {
      "name": "4. Consulta (lembrete na fila e e-mail)",
      "item": [
        {
          "name": "4.1 Responsável agenda a consulta (pelo gateway)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{dotnetUrl}}/api/clinico/consultas"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataHora\": \"{{dataConsulta}}\",\n  \"observacoes\": \"Primeira consulta\",\n  \"status\": \"AGENDADA\",\n  \"petId\": {{petId}},\n  \"veterinarioId\": {{vetId}},\n  \"unidadeId\": {{unidadeId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenResp}}",
                  "type": "string"
                }
              ]
            },
            "description": "Depois do commit o Java publica o lembrete no RabbitMQ (o .NET cria) e envia o e-mail de confirmação pela Brevo."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 3 * 86400000);",
                  "d.setUTCHours(13 + Math.floor(Math.random() * 6), [0, 15, 30, 45][Math.floor(Math.random() * 4)], 0, 0);",
                  "pm.collectionVariables.set('dataConsulta', d.toISOString().slice(0, 19));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status esperado (200, 201)', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('consultaId', corpo.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Mesmo horário de novo: agenda ocupada (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{dotnetUrl}}/api/clinico/consultas"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataHora\": \"{{dataConsulta}}\",\n  \"status\": \"AGENDADA\",\n  \"petId\": {{petId}},\n  \"veterinarioId\": {{vetId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenResp}}",
                  "type": "string"
                }
              ]
            },
            "description": "Regra de negócio: o mesmo veterinário não atende dois pets no mesmo horário."
