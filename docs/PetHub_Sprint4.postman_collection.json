    {
      "name": "3. Pet",
      "item": [
        {
          "name": "3.1 Veterinário cadastra o pet para o CPF do responsável",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{javaUrl}}/api/pets"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mel\",\n  \"especie\": \"Cachorro\",\n  \"raca\": \"SRD\",\n  \"dataNascimento\": \"2022-05-10\",\n  \"peso\": 12.5,\n  \"genero\": \"Fêmea\",\n  \"responsavelCpf\": \"{{cpf}}\",\n  \"veterinarioResponsavelId\": {{vetId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVet}}",
                  "type": "string"
                }
              ]
            },
            "description": "O Java pergunta ao .NET quem é o dono desse CPF, usando o JWT de serviço (X-Service-Authorization)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status esperado (200, 201)', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('petId', corpo.id);"
                ]
              }
            }
          ]
        },
        {
