  "item": [
    {
      "name": "1. Veterinário (Java)",
      "item": [
        {
          "name": "1.1 Registrar veterinário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{javaUrl}}/api/auth/registrar/veterinario"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Dra. Teste Postman\",\n  \"crmv\": \"{{crmv}}\",\n  \"especialidade\": \"Clínica geral\",\n  \"email\": \"{{emailVet}}\",\n  \"senha\": \"senha123\",\n  \"ativo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Cadastro público do veterinário. Já devolve o token JWT; o script guarda em {{tokenVet}}."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = Date.now().toString();",
                  "pm.collectionVariables.set('sufixo', s);",
                  "pm.collectionVariables.set('emailVet', 'vet.' + s + '@pethub.teste');",
                  "pm.collectionVariables.set('crmv', 'SP-' + s.slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status esperado (200, 201)', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('tokenVet', corpo.token);",
                  "pm.collectionVariables.set('vetId', corpo.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login do veterinário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{javaUrl}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailVet}}\",\n  \"senha\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Login no Java. A senha errada devolve 401 'Credenciais inválidas'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status esperado (200)', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('tokenVet', corpo.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Criar unidade veterinária",
