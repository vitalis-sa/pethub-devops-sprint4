            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"veterinarioId\": {{vetId}},\n  \"nome\": \"PetHub Paulista\",\n  \"logradouro\": \"Av. Paulista\",\n  \"numero\": \"1106\",\n  \"bairro\": \"Bela Vista\",\n  \"cidade\": \"São Paulo\",\n  \"estado\": \"SP\",\n  \"cep\": \"01311000\"\n}",
              "options": {
                "raw": {
