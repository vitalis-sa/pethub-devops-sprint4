# Copie este arquivo para .env e preencha com seus valores reais.
# O .env nunca é commitado (veja .gitignore); .env.example é o único
# que fica versionado, como referência de quais variáveis existem.
#
# Uso local (Oracle da FIAP, direto no host):
#   1. cp .env.example .env
#   2. preencha DB_USER, DB_PASSWORD e JWT_SECRET abaixo
#   3. .\run.ps1        (PowerShell — carrega o .env e roda a aplicação)
#
# Credenciais do Oracle da FIAP (usuário RM e senha do banco)
DB_USER=
DB_PASSWORD=

# Opcional. Só defina para apontar para outro banco (ex.: container local).
# Sem isso, usa o Oracle da FIAP em oracle.fiap.com.br:1521/orcl.
# DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1

# Segredo de assinatura dos tokens JWT. Use pelo menos 32 caracteres
# (256 bits) para o algoritmo HS256 funcionar. Gere um valor aleatório,
# por exemplo: openssl rand -base64 32
JWT_SECRET=

# Chave da API do Groq (gere em console.groq.com/keys). Sem ela, os endpoints
# de IA respondem 503 e o resto da API segue funcionando.
GROQ_API_KEY=

# Id do modelo usado nas funcoes de IA (opcional; padrao: openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# Google Cloud Storage (exames em exames/, fotos em fotos/). O Java so assina URLs temporarias.
# Local: GOOGLE_APPLICATION_CREDENTIALS = JSON de uma conta de servico com acesso ao bucket e
# permissao de assinar (Service Account Token Creator em si mesma). No Cloud Run, a conta do servico.
GCP_PROJECT_ID=vitalis-pethub
GCS_BUCKET=vitalis-docs
# GOOGLE_APPLICATION_CREDENTIALS=

# Autenticacao entre servicos (JWT HS256). Segredo com ao menos 32 caracteres, IGUAL ao ServicoAuth__Segredo do .NET.
# Gerar: openssl rand -base64 48
# Vazio = o .NET nao age em nome de responsaveis e o Java nao consulta o .NET.
SERVICE_JWT_SECRET=
# URL do servico .NET de responsaveis
RESPONSAVEIS_URL=

# RabbitMQ no CloudAMQP (painel da instancia). O vhost costuma ser igual ao usuario.
# Porta 5671 com RABBIT_SSL=true. Para RabbitMQ local: localhost, 5672, guest/guest, "/", false.
RABBIT_HOST=
RABBIT_PORT=5671
RABBIT_USER=
RABBIT_PASSWORD=
RABBIT_VHOST=
RABBIT_SSL=true

# Brevo (e-mail de confirmacao). O remetente precisa estar verificado na conta Brevo.
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=
# BREVO_REMETENTE_NOME=PetHub

# Armazenamento de exames e fotos: "gcs" (bucket, padrao) ou "local" (disco, para desenvolver sem conta do Google).
# ARMAZENAMENTO_MODO=local
# URL pela qual o APP alcanca este servico (celular: IP da maquina na rede; emulador Android: http://10.0.2.2:8080)
# ARMAZENAMENTO_URL_PUBLICA=http://localhost:8080
# ARMAZENAMENTO_PASTA=./arquivos-locais
